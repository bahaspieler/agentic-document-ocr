<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.8.3" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.18.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.18.0" />
    <!--
      Microsoft.Agents.AI.Workflows.Generators is deliberately absent. It writes routing tables for
      executors that declare their handlers with attributes; ours build theirs in ConfigureProtocol
      instead, so it emitted nothing here. It is also compiled against a newer Roslyn than the
      older SDK images carried, so inside the container it failed to load and said so as a warning
      on every release build, which is a bad thing to have to explain away in a build log.
    -->
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.18.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" Version="4.8.1-rc" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
  </ItemGroup>

  <!--
    Container builds run on Linux, where OpenCvSharp has no native library of its own. The version is
    deliberately ahead of the managed package: builds up to 4.11 link against Ubuntu 20.04 libraries
    (libjpeg.so.8, libtiff.so.5, OpenEXR 2.5, and libtesseract.so.4, which would fight the Tesseract 5
    the OCR engine needs), while 4.13 needs only the GTK3 family that Debian ships. Native exports are
    additive, so the older managed package binds against it, the same way macOS already runs an older
    native build than its managed one.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Models\u2netp.onnx')" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Workflows\Definitions\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\tessdata')" />
  </ItemGroup>

</Project>
