{
  "Storage": {
    "Provider": "sftp",
    "Local": {
      "RootPath": "./Storage"
    },
    "Sftp": {
      "Host": "localhost",
      "Port": 2222,
      "Username": "ocragent",
      "AuthenticationMethod": "password",
      "Password": null,
      "PrivateKeyPath": null,
      "PrivateKeyPassphrase": null,
      "RemoteBasePath": "/ocr",
      "ConnectionPool": {
        "MinConnections": 1,
        "MaxConnections": 10,
        "ConnectionIdleTimeout": 300,
        "KeepAliveInterval": 60,
        "EnableHealthChecks": true,
        "HealthCheckInterval": 30
      },
      "Retry": {
        "MaxRetries": 3,
        "InitialDelayMs": 100,
        "MaxDelayMs": 5000,
        "BackoffMultiplier": 2.0,
        "RetryableExceptions": ["SshConnectionException", "SftpPathNotFoundException"]
      },
      "Timeouts": {
        "ConnectionTimeout": 30,
        "OperationTimeout": 300,
        "UploadTimeout": 600
      },
      "Behavior": {
        "CreateRemoteDirectoryIfNotExists": true,
        "UseCompression": true,
        "BufferSize": 32768,
        "EnableDebugFolders": true
      }
    }
  },
  "Agent": {
    "OpenAI": {
      "ModelId": "gpt-4o",
      "ApiKey": null
    }
  }
}
