<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OcrAgent.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcrAgent\OcrAgent.csproj" />
  </ItemGroup>

  <!-- Content that OcrAgent tools load from AppContext.BaseDirectory -->
  <ItemGroup>
    <Content Include="..\OcrAgent\Workflows\Definitions\*.json" Link="Workflows\Definitions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OcrAgent\Assets\tessdata\*.traineddata" Link="Assets\tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\OcrAgent\Assets\tessdata')" />
    <Content Include="..\OcrAgent\Assets\Models\u2netp.onnx" Link="Assets\Models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\OcrAgent\Assets\Models\u2netp.onnx')" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!--
    OcrAgent is an executable in its own right and carries its own appsettings.json, which content
    flow from the project reference then delivers here under the same relative path as this host's
    file. A build silently lets the local file win; a publish refuses to guess and fails. Drop the
    incoming copy, since this host reads its own settings.
  -->
  <Target Name="RemoveEngineAppSettingsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'appsettings.json' AND '%(RootDir)%(Directory)' != '$([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory)))'" />
    </ItemGroup>
  </Target>

  <!--
    macOS (Apple Silicon) OCR support. Tesseract's InteropDotNet loader resolves the arm64
    native libraries from an x64/ subfolder next to the assembly. The base OcrAgent project
    provisions these dylibs into its own output via scripts/setup-native-libs.sh; forward the
    same files into this host so RunOcr works here too. No-op on Windows or when the libs are
    not present (Tesseract simply stays disabled, exactly as in OcrAgent).
  -->
  <Target Name="ForwardMacTesseractNativeLibs" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <_OcrAgentMacNativeLib Include="$(MSBuildProjectDirectory)\..\OcrAgent\bin\$(Configuration)\$(TargetFramework)\x64\libleptonica-*.dylib" />
      <_OcrAgentMacNativeLib Include="$(MSBuildProjectDirectory)\..\OcrAgent\bin\$(Configuration)\$(TargetFramework)\x64\libtesseract*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(_OcrAgentMacNativeLib)" DestinationFolder="$(OutDir)x64" SkipUnchangedFiles="true" Condition="'@(_OcrAgentMacNativeLib)' != ''" />
  </Target>

</Project>
