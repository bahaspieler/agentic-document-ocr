<Project>
  <PropertyGroup>
    <!--
      .NET 10 is the supported default. Set OcrAgentTargetFramework=net8.0 only as a
      temporary rollback guard while diagnosing a runtime or dependency regression.
    -->
    <OcrAgentTargetFramework Condition="'$(OcrAgentTargetFramework)' == ''">net10.0</OcrAgentTargetFramework>
    <TargetFramework>$(OcrAgentTargetFramework)</TargetFramework>
  </PropertyGroup>

  <Target Name="ValidateOcrAgentTargetFramework" BeforeTargets="PrepareForBuild"
          Condition="'$(OcrAgentTargetFramework)' != 'net10.0' AND '$(OcrAgentTargetFramework)' != 'net8.0'">
    <Error Text="Unsupported OcrAgentTargetFramework '$(OcrAgentTargetFramework)'. Use net10.0 (default) or net8.0 (rollback guard)." />
  </Target>
</Project>
