# Copy to .env at this folder and fill in. The .env file is gitignored and never committed.
#
# Both OcrAgent and OcrAgent.Mcp read it at start-up, searching from the working directory
# upwards, so one file here serves the console app, the MCP server, and the helper scripts.
# Anything already exported in the shell wins over the value here.
#
# Keys prefixed OCR_ map onto appsettings.json: a double underscore is a nesting level, so
# OCR_Storage__AzureBlob__ContainerName is Storage:AzureBlob:ContainerName.

# Secrets
AZURE_STORAGE_CONNECTION_STRING=
OPENAI_API_KEY=
# Created and populated by scripts/azure-sql.sh
AZURE_SQL_ADMIN_PASSWORD=
OCR_Sql__Enabled=false
OCR_Sql__ConnectionString=

# Chat model, defaults to gpt-4o-mini when unset
# OPENAI_CHATCOMPLETION_DEPLOYMENT=gpt-4o-mini

# Image store: local, sftp, or azureblob
OCR_Storage__Provider=azureblob
OCR_Storage__AzureBlob__ContainerName=ocr-images
OCR_Storage__AzureBlob__BlobPrefix=

# Run records: none, or azuretable. The connection string above is reused when this is empty.
OCR_Runs__Provider=azuretable
OCR_Runs__TableName=OcrRuns
OCR_Runs__GroupId=HiddenLayer

# Optional Microsoft login. The app remains fully usable anonymously when disabled.
# The Entra app must support organizational directories and personal Microsoft accounts,
# expose api://<client-id>/access_as_user, and register the deployed origin as a SPA redirect URI.
OCR_Auth__Enabled=false
OCR_Auth__ClientId=
OCR_Auth__TenantId=common
OCR_Auth__Instance=https://login.microsoftonline.com/

# Azure hosting (Phase 5). Location is taken from the resource group; the scripts never
# create or delete the group. Override a name here only if you have to.
# AZURE_RESOURCE_GROUP=RG_Hidden_Layer
# AZURE_ACR_NAME=acrhiddenlayerocr
# AZURE_CONTAINER_APP_NAME=ca-ocr-agent
# AZURE_CONTAINER_APP_ENV=cae-ocr-agent
#
# Replica ceiling. The deployment keeps one replica live for the submitted Web UI.
# AZURE_MAX_REPLICAS=3
