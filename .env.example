# OcrAgent Configuration - Environment Variables Template
# Copy this file to .env and update with your values
# Add .env to .gitignore to avoid committing sensitive data

# ============================================
# Storage Provider Selection
# ============================================
# Options: "local" or "sftp"
OCR_Storage__Provider=local

# ============================================
# Local Storage Configuration
# ============================================
OCR_Storage__Local__RootPath=./Storage

# ============================================
# SFTP Storage Configuration
# ============================================

# Connection Settings
OCR_Storage__Sftp__Host=localhost
OCR_Storage__Sftp__Port=22
OCR_Storage__Sftp__Username=ocragent
OCR_Storage__Sftp__RemoteBasePath=/ocr

# Authentication Method
# Options: "password", "privatekey", or "agent"
OCR_Storage__Sftp__AuthenticationMethod=password

# SFTP Password (used by both the app and Docker container)
SFTP_PASSWORD=your_password_here

# Private Key Authentication (if AuthenticationMethod=privatekey)
# OCR_Storage__Sftp__PrivateKeyPath=/path/to/private/key
# OCR_Storage__Sftp__PrivateKeyPassphrase=key_passphrase_if_encrypted

# Connection Pool Settings
OCR_Storage__Sftp__ConnectionPool__MinConnections=1
OCR_Storage__Sftp__ConnectionPool__MaxConnections=10
OCR_Storage__Sftp__ConnectionPool__ConnectionIdleTimeout=300
OCR_Storage__Sftp__ConnectionPool__KeepAliveInterval=60
OCR_Storage__Sftp__ConnectionPool__EnableHealthChecks=true
OCR_Storage__Sftp__ConnectionPool__HealthCheckInterval=30

# Retry Policy
OCR_Storage__Sftp__Retry__MaxRetries=3
OCR_Storage__Sftp__Retry__InitialDelayMs=100
OCR_Storage__Sftp__Retry__MaxDelayMs=5000
OCR_Storage__Sftp__Retry__BackoffMultiplier=2.0

# Timeouts (in seconds)
OCR_Storage__Sftp__Timeouts__ConnectionTimeout=30
OCR_Storage__Sftp__Timeouts__OperationTimeout=300
OCR_Storage__Sftp__Timeouts__UploadTimeout=600

# Behavior Settings
OCR_Storage__Sftp__Behavior__CreateRemoteDirectoryIfNotExists=true
OCR_Storage__Sftp__Behavior__UseCompression=true
OCR_Storage__Sftp__Behavior__BufferSize=32768
OCR_Storage__Sftp__Behavior__EnableDebugFolders=true

# ============================================
# OpenAI Agent Configuration
# ============================================
OCR_Agent__OpenAI__ModelId=gpt-4o
OCR_Agent__OpenAI__ApiKey=your_openai_api_key_here

# ============================================
# Logging Configuration
# ============================================
OCR_Logging__LogLevel__Default=Information
OCR_Logging__LogLevel__OcrAgent.Storage=Debug

# ============================================
# Development Settings
# ============================================
# .NET Environment
DOTNET_ENVIRONMENT=Development

# For local SFTP testing with Docker
# OCR_Storage__Provider=sftp
# OCR_Storage__Sftp__Host=localhost
# OCR_Storage__Sftp__Port=2222
# OCR_Storage__Sftp__Username=ocragent
# OCR_Storage__Sftp__Password=password
# OCR_Storage__Sftp__RemoteBasePath=/ocr
