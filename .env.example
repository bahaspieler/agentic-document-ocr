# Copy to .env at this folder and fill in. The .env file is gitignored and never committed.
#
# Both OcrAgent and OcrAgent.Mcp read it at start-up, searching from the working directory
# upwards, so one file here serves the console app, the MCP server, and the helper scripts.
# Anything already exported in the shell wins over the value here.
#
# Keys prefixed OCR_ map onto appsettings.json: a double underscore is a nesting level, so
# OCR_Storage__AzureBlob__ContainerName is Storage:AzureBlob:ContainerName.

# Secrets
AZURE_STORAGE_CONNECTION_STRING=
OPENAI_API_KEY=

# Chat model, defaults to gpt-4o-mini when unset
# OPENAI_CHATCOMPLETION_DEPLOYMENT=gpt-4o-mini

# Image store: local, sftp, or azureblob
OCR_Storage__Provider=azureblob
OCR_Storage__AzureBlob__ContainerName=ocr-images
OCR_Storage__AzureBlob__BlobPrefix=

# Run records: none, or azuretable. The connection string above is reused when this is empty.
OCR_Runs__Provider=azuretable
OCR_Runs__TableName=OcrRuns
OCR_Runs__GroupId=HiddenLayer
